---
import { site } from '@data/site';
// Loads GA4 only in the production build (never on localhost).
// Uses Google Consent Mode v2: analytics run in COOKIELESS mode by default
// (so aggregate traffic is still visible), and upgrade to full cookies only
// after the visitor clicks "Accept" on the cookie banner.
const enabled = import.meta.env.PROD && !!site.analyticsId;
const id = site.analyticsId;
---
{enabled && (
  <>
    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      // Default: everything denied → GA sends cookieless pings (privacy-friendly).
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
      // If the visitor already accepted in a previous visit, upgrade now.
      if (localStorage.getItem('cookie-consent') === 'accepted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
      gtag('js', new Date());
      gtag('config', id, { anonymize_ip: true });
    </script>
  </>
)}
