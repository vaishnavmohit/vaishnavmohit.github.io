---
import { site } from '@data/site';
// Load GA4 only in the production build (never on localhost) and only AFTER
// the visitor accepts cookies. The cookie banner calls window.loadGA().
const enabled = import.meta.env.PROD && !!site.analyticsId;
const id = site.analyticsId;
---
{enabled && (
  <script is:inline define:vars={{ id }}>
    window.loadGA = function () {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', id, { anonymize_ip: true });
    };
    if (localStorage.getItem('cookie-consent') === 'accepted') window.loadGA();
  </script>
)}
