---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  class?: string;
}
const { id, eyebrow, title, lead, class: cls = '' } = Astro.props;
---
<section id={id} class:list={['container-page py-16 sm:py-20', cls]}>
  {(eyebrow || title || lead) && (
    <div class="mb-10 max-w-2xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">{title}</h2>}
      {lead && <p class="mt-3 text-lg text-ink-soft dark:text-slate-400">{lead}</p>}
    </div>
  )}
  <slot />
</section>
