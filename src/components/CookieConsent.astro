---
import { site } from '@data/site';
// Only meaningful when analytics is configured.
const show = !!site.analyticsId;
---
{show && (
  <div id="cookie-banner" hidden
    class="fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-xl backdrop-blur-md sm:flex sm:items-center sm:gap-4 dark:border-slate-700 dark:bg-slate-900/95">
    <p class="text-sm text-ink-soft dark:text-slate-300">
      This site uses cookies for anonymous analytics to understand traffic.
      <a href="/privacy" class="font-medium text-brand-600 underline-offset-2 hover:underline dark:text-brand-300">Learn more</a>.
    </p>
    <div class="mt-3 flex shrink-0 gap-2 sm:mt-0">
      <button id="cookie-decline" type="button"
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium text-ink-soft hover:border-slate-400 dark:border-slate-600 dark:text-slate-300">Decline</button>
      <button id="cookie-accept" type="button"
        class="rounded-full bg-accent-500 px-4 py-1.5 text-sm font-semibold text-white hover:bg-accent-600">Accept</button>
    </div>
  </div>

  <script is:inline>
    (function () {
      var b = document.getElementById('cookie-banner');
      if (!b) return;
      if (!localStorage.getItem('cookie-consent')) b.hidden = false;
      var hide = function (v) { localStorage.setItem('cookie-consent', v); b.hidden = true; };
      document.getElementById('cookie-accept').addEventListener('click', function () {
        hide('accepted');
        if (window.loadGA) window.loadGA();
      });
      document.getElementById('cookie-decline').addEventListener('click', function () {
        hide('declined');
      });
    })();
  </script>
)}
