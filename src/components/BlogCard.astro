---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a href={`/blog/${post.slug}`} class="card card-hover block">
  <div class="flex flex-wrap items-center gap-3 text-xs text-ink-faint">
    <time>{fmt(post.data.date)}</time>
    {post.data.tags.map((t) => <span class="rounded-full bg-brand-50 px-2 py-0.5 font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">{t}</span>)}
  </div>
  <h2 class="mt-3 font-display text-2xl font-bold text-ink dark:text-white">{post.data.title}</h2>
  <p class="mt-2 text-ink-soft dark:text-slate-400">{post.data.description}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 dark:text-brand-300">Read post <Icon name="arrow" class="h-4 w-4" /></span>
</a>
