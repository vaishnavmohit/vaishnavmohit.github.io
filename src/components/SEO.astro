---
import { site, sameAsProfiles } from '@data/site';
import { buildGraph, type PageType } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Open Graph type: website | article | profile */
  type?: string;
  noindex?: boolean;
  /** schema.org type of this page. ProfilePage marks the page as being *about you*. */
  pageType?: PageType;
  /** Extra JSON-LD nodes to append to the graph (ScholarlyArticle list, Thesis, BlogPosting…) */
  schema?: Record<string, unknown>[];
  /** @deprecated use pageType="ProfilePage" */
  isHome?: boolean;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  noindex = false,
  isHome = false,
  schema = [],
} = Astro.props;

const pageType: PageType = Astro.props.pageType ?? (isHome ? 'ProfilePage' : 'WebPage');
const ogType = Astro.props.type ?? (pageType === 'ProfilePage' ? 'profile' : 'website');

const pageTitle = title ? `${title} · ${site.shortTitle}` : `${site.shortTitle} — ${site.role}`;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const ogImageUrl = new URL(image, site.url).href;

// Make sure the page's primary image is always one of the Person images, so
// the primaryImageOfPage reference resolves inside the graph.
const graph = buildGraph({
  pathname,
  pageType,
  title: title ?? site.fullName,
  description,
  image,
  extra: schema,
});
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={site.keywords.join(', ')} />
<meta name="author" content={site.fullName} />
<link rel="canonical" href={canonical} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
)}
{site.googleSiteVerification && (
  <meta name="google-site-verification" content={site.googleSiteVerification} />
)}

<!-- Identity: reciprocal rel="me" links (IndieAuth / entity verification) -->
{sameAsProfiles.map((href) => <link rel="me" href={href} />)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={site.fullName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.fullName} />
{ogType === 'profile' && (
  <>
    <meta property="profile:first_name" content="Mohit" />
    <meta property="profile:last_name" content="Vaishnav" />
    <meta property="profile:username" content="mohitvaishnav" />
  </>
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@mohitvaishnav" />
<meta name="twitter:creator" content="@mohitvaishnav" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured data: one graph per page, shared @id URIs across the site -->
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
