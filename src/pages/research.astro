---
import Base from '@layouts/Base.astro';
import PubCard from '@components/PubCard.astro';
import Icon from '@components/Icon.astro';
import { site, academicProfiles } from '@data/site';
import pubData from '@data/publications.json';
import { highlights, themes, workInProgress } from '@data/research';
import { publicationsListNode } from '../lib/schema';

const pubs = [...pubData.publications].sort((a, b) => (b.year - a.year) || (b.citations - a.citations));
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a);
const firstYear = years[years.length - 1];
---
<Base
  title="Research"
  description={`Research by Dr. Mohit Vaishnav — how vision-language models perceive and reason. ${pubs.length} papers (TMLR, NeurIPS, ICLR, CoNLL), and work in progress.`}
  pageType="CollectionPage"
  schema={[publicationsListNode()]}
>
  <section class="container-page py-16 sm:py-20">
    <p class="eyebrow">Research</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">Seeing vs. reasoning in AI</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft dark:text-slate-400">
      Fifteen years of work on how machines see and reason — from lossless video coding to attention-and-memory
      architectures to probing today's vision-language models — published at TMLR, NeurIPS, ICLR, CoNLL,
      Neural Computation and IEEE DCC.
    </p>

    <div class="mt-8 flex flex-wrap gap-8">
      <div><p class="font-display text-2xl font-bold text-brand-600 dark:text-brand-400">{pubs.length}</p><p class="text-sm text-ink-faint">Publications</p></div>
      <div><p class="font-display text-2xl font-bold text-brand-600 dark:text-brand-400">{workInProgress.length}</p><p class="text-sm text-ink-faint">In progress</p></div>
      <div><p class="font-display text-2xl font-bold text-brand-600 dark:text-brand-400">{firstYear}</p><p class="text-sm text-ink-faint">First paper</p></div>
    </div>

    <!-- Academic profiles (authoritative identity backlinks) -->
    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Profiles</span>
      {academicProfiles.map((p) => (
        <a href={p.href} target="_blank" rel="me noopener" class="inline-flex items-center gap-1 text-sm font-medium link-underline">
          {p.label} <Icon name="external" class="h-3 w-3" />
        </a>
      ))}
    </div>

    <!-- Latest highlights -->
    <div class="mt-12">
      <p class="eyebrow">Latest</p>
      <ol class="mt-4 grid gap-4 md:grid-cols-2">
        {highlights.map((h) => {
          const Tag = h.href ? 'a' : 'div';
          const ext = h.href?.startsWith('http');
          return (
            <li>
              <Tag href={h.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}
                class:list={['card flex h-full gap-4', h.href && 'card-hover']}>
                <span class="w-16 shrink-0 font-display text-sm font-bold text-accent-600 dark:text-accent-400">{h.date}</span>
                <span>
                  <span class="block font-semibold text-ink dark:text-white">{h.title}</span>
                  <span class="mt-1 block text-sm text-ink-soft dark:text-slate-400">{h.detail}</span>
                </span>
              </Tag>
            </li>
          );
        })}
      </ol>
    </div>

    <!-- Research vision (establishes the active-researcher entity) -->
    <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50/60 p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900/30">
      <p class="eyebrow">Research direction</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-ink dark:text-white">Probing how vision-language models actually reason</h2>
      <p class="mt-3 max-w-3xl text-ink-soft dark:text-slate-400">
        My current research — as a postdoctoral researcher at TalTech under the EXAI grant — asks a
        deceptively simple question: when a large vision-language model answers correctly, is it
        <em>reasoning</em>, or pattern-matching? I design cognitive-paradigm evaluations that decouple
        perception from reasoning, build benchmarks that resist shortcut-learning, and develop agents whose
        attention and memory are guided rather than brute-forced — extending the GAMR line of work from my PhD.
      </p>
      <p class="mt-3 max-w-3xl text-ink-soft dark:text-slate-400">
        The throughline across a decade of work: <strong class="text-ink dark:text-white">attention and memory
        as the levers of efficient, generalizable intelligence</strong> — in brains, in models, and now in
        the products we build at Kimova AI.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">Recent: TMLR 2026 · J2C at NeurIPS 2026 · CoNLL 2026, oral at ACL 2026 · CVPR Workshop 2026</span>
      </div>
    </div>

    <!-- Research dimensions -->
    <div class="mt-16">
      <p class="eyebrow">Research dimensions</p>
      <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink dark:text-white">One question, asked at every scale</h2>
      <ol class="mt-8 space-y-4 border-l-2 border-slate-200 pl-6 dark:border-slate-800">
        {themes.map((t, i) => (
          <li class="relative">
            <span class:list={['absolute -left-[1.95rem] top-7 h-3 w-3 rounded-full ring-4 ring-white dark:ring-[#080c18]', i === 0 ? 'bg-signal-500' : 'bg-brand-400']}></span>
            <div class="card">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">{t.period}</p>
              <h3 class="mt-1 font-display text-lg font-bold text-ink dark:text-white">{t.title}</h3>
              <p class="mt-2 max-w-3xl text-sm text-ink-soft dark:text-slate-400">{t.summary}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {t.papers.map((p) => p.href ? (
                  <a href={p.href} target={p.href.startsWith('http') ? '_blank' : undefined} rel={p.href.startsWith('http') ? 'noopener' : undefined}
                    class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-ink-soft transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:text-slate-300 dark:hover:text-brand-300">{p.label}</a>
                ) : (
                  <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-ink-faint dark:border-slate-700">{p.label}</span>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Research ↔ entrepreneurship -->
    <div class="mt-12 grid gap-6 rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50/80 to-white p-6 sm:p-8 md:grid-cols-[1.4fr_1fr] dark:border-brand-800 dark:from-brand-500/5 dark:to-transparent">
      <div>
        <p class="eyebrow">From lab to product</p>
        <h2 class="mt-2 font-display text-2xl font-bold text-ink dark:text-white">The same question drives Kimova AI</h2>
        <p class="mt-3 text-ink-soft dark:text-slate-400">
          Asking whether a model really reasoned or merely matched a pattern is, in industry, the difference
          between an AI you can trust with an audit and one you can't. At
          <a href={site.company.url} target="_blank" rel="noopener" class="link-underline">Kimova AI</a> we bring
          that research discipline — grounded evidence, measurable failure modes, evaluation before scale — to
          automating ISO 27001 cybersecurity audits.
        </p>
      </div>
      <ul class="space-y-3 self-center text-sm">
        <li class="flex gap-3"><span class="font-display font-bold text-brand-600 dark:text-brand-300">Research</span><span class="text-ink-soft dark:text-slate-400">Diagnose perception vs. reasoning failures in VLMs</span></li>
        <li class="flex gap-3"><span class="font-display font-bold text-accent-600 dark:text-accent-400">Product</span><span class="text-ink-soft dark:text-slate-400">Trustworthy AI for ISO 27001 compliance audits</span></li>
      </ul>
    </div>

    <!-- Work in progress -->
    <div class="mt-16" id="in-progress">
      <p class="eyebrow">Work in progress</p>
      <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink dark:text-white">On the bench now</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {workInProgress.map((w) => (
          <article class="card border-dashed">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700 dark:bg-accent-500/10 dark:text-accent-300">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent-500"></span>{w.status}
            </span>
            <h3 class="mt-3 font-display text-lg font-semibold leading-snug text-ink dark:text-white">{w.title}</h3>
            <p class="mt-1.5 text-sm text-ink-soft dark:text-slate-400">{w.authors}</p>
            {w.summary && <p class="mt-3 text-sm text-ink-soft dark:text-slate-400">{w.summary}</p>}
          </article>
        ))}
      </div>
    </div>

    <!-- PhD thesis highlight -->
    <a href="/phd-thesis" class="mt-6 flex items-center gap-4 rounded-2xl border border-brand-200 bg-brand-50/60 p-5 transition-colors hover:border-brand-400 dark:border-brand-800 dark:bg-brand-500/5">
      <img src="/img/phd-thesis-112.webp" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-lg border border-slate-200 object-cover dark:border-slate-700" />
      <div class="min-w-0">
        <p class="text-sm font-semibold text-ink dark:text-white">PhD Thesis — Exploring the role of (self-)attention in cognitive &amp; computer vision</p>
        <p class="text-sm text-ink-soft dark:text-slate-400">Brown University / ANITI, 2023 · committee from Princeton, DeepMind &amp; CentraleSupélec →</p>
      </div>
    </a>

    <!-- Publications -->
    <h2 id="publications" class="mt-16 scroll-mt-24 font-display text-3xl font-bold tracking-tight text-ink dark:text-white">Publications</h2>
    <p class="mt-2 text-sm text-ink-faint">Venue ranks are the <a href="https://portal.core.edu.au/conf-ranks/" target="_blank" rel="noopener" class="link-underline">CORE</a> ranking in force when each paper was published.</p>

    <!-- Filters -->
    <div class="mt-6 flex flex-wrap gap-2" id="filters">
      <button class="filter-btn is-active" data-filter="all">All</button>
      {years.map((y) => <button class="filter-btn" data-filter={String(y)}>{y}</button>)}
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2" id="pub-grid">
      {pubs.map((pub) => <PubCard pub={pub} />)}
    </div>
  </section>
</Base>

<style>
  .filter-btn {
    @apply rounded-full border border-slate-200 px-4 py-1.5 text-sm font-medium text-ink-soft transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:text-slate-400;
  }
  .filter-btn.is-active {
    @apply border-brand-500 bg-brand-500 text-white hover:text-white dark:border-brand-500;
  }
</style>

<script>
  const grid = document.getElementById('pub-grid');
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const f = btn.dataset.filter;
      grid?.querySelectorAll<HTMLElement>('[data-year]').forEach((card) => {
        const show = f === 'all' || card.dataset.year === f;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
