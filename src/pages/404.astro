---
import Base from '@layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="font-display text-7xl font-bold text-brand-500">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-ink dark:text-white">This page wandered off.</h1>
    <p class="mt-2 text-ink-soft dark:text-slate-400">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-8">Back home</a>
  </section>
</Base>
