---
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import { experience, earlyVentures, education } from '@data/experience';
---
<Base title="Experience" description="Professional journey of Dr. Mohit Vaishnav — from PhD research at Brown University to founding Kimova AI, spanning roles at TalTech, Sandvik and DFKI.">
  <section class="container-page py-16 sm:py-20">
    <p class="eyebrow">Career</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">Experience</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft dark:text-slate-400">
      A path across entrepreneurship, frontier research and applied AI in industry — over 10 countries.
    </p>
  </section>

  <!-- Main timeline -->
  <section class="container-page pb-4">
    <ol class="relative border-l-2 border-slate-200 pl-6 dark:border-slate-800">
      {experience.map((r) => (
        <li class="relative mb-10">
          <span class:list={['absolute -left-[31px] mt-1.5 h-4 w-4 rounded-full border-2 border-white dark:border-[#080c18]', r.current ? 'bg-signal-500' : 'bg-brand-500']}></span>
          <div class="card card-hover">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-xl font-bold text-ink dark:text-white">{r.title}</h3>
              <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', r.current ? 'bg-signal-500/10 text-signal-600 dark:text-signal-400' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300']}>{r.period}</span>
            </div>
            <p class="text-sm font-medium text-brand-600 dark:text-brand-300">{r.org}{r.location && <span class="text-ink-faint"> · {r.location}</span>}</p>
            {r.summary && <p class="mt-3 text-sm text-ink-soft dark:text-slate-400">{r.summary}</p>}
            {r.points && (
              <ul class="mt-3 space-y-1.5">
                {r.points.map((p) => (
                  <li class="flex gap-2 text-sm text-ink-soft dark:text-slate-400">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>{p}
                  </li>
                ))}
              </ul>
            )}
            {r.tags && (
              <div class="mt-4 flex flex-wrap gap-2">
                {r.tags.map((t) => <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">{t}</span>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Early ventures + Education -->
  <Section eyebrow="Where it started" title="Early ventures">
    <div class="grid gap-6 md:grid-cols-2">
      {earlyVentures.map((v) => (
        <div class="card">
          <h3 class="font-display text-lg font-bold text-ink dark:text-white">{v.name}</h3>
          <p class="text-sm font-medium text-brand-600 dark:text-brand-300">{v.role} · <span class="text-ink-faint font-normal">{v.location}</span></p>
          <p class="mt-3 text-sm text-ink-soft dark:text-slate-400">{v.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Education" title="Academic foundation">
    <div class="space-y-5">
      {education.map((e) => (
        <div class="card">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-lg font-bold text-ink dark:text-white">{e.degree}</h3>
            <span class="text-sm font-medium text-ink-faint">{e.period}</span>
          </div>
          {e.field && <p class="text-sm font-medium text-brand-600 dark:text-brand-300">{e.field}</p>}
          <p class="mt-1 text-sm text-ink-soft dark:text-slate-400">{e.institutions}</p>
          {e.thesis && <p class="mt-2 text-sm text-ink-faint"><span class="font-medium text-ink-soft dark:text-slate-300">Thesis:</span> {e.thesis}</p>}
          {e.supervisor && <p class="text-sm text-ink-faint"><span class="font-medium text-ink-soft dark:text-slate-300">Advisor:</span> {e.supervisor}</p>}
        </div>
      ))}
    </div>
  </Section>
</Base>
