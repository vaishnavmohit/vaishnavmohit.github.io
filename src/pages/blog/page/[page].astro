---
import Base from '@layouts/Base.astro';
import BlogCard from '@components/BlogCard.astro';
import Pagination from '@components/Pagination.astro';
import { getSortedPosts, POSTS_PER_PAGE } from '../../../lib/blog';

// Generates /blog/page/2, /blog/page/3, … (page 1 lives at /blog).
export async function getStaticPaths() {
  const allPosts = await getSortedPosts();
  const lastPage = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
  const paths = [];
  for (let p = 2; p <= lastPage; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        posts: allPosts.slice((p - 1) * POSTS_PER_PAGE, p * POSTS_PER_PAGE),
        currentPage: p,
        lastPage,
      },
    });
  }
  return paths;
}

const { posts, currentPage, lastPage } = Astro.props;
---
<Base title={`Blog · page ${currentPage}`} description="Writing by Dr. Mohit Vaishnav on applied AI, entrepreneurship, compliance and research.">
  <section class="container-page py-16 sm:py-20">
    <p class="eyebrow">Writing</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">Blog</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft dark:text-slate-400">Page {currentPage} of {lastPage}</p>

    <div class="mt-12 space-y-6">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={currentPage} lastPage={lastPage} />
  </section>
</Base>
