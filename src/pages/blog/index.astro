---
import Base from '@layouts/Base.astro';
import BlogCard from '@components/BlogCard.astro';
import Pagination from '@components/Pagination.astro';
import { getSortedPosts, POSTS_PER_PAGE } from '../../lib/blog';

const allPosts = await getSortedPosts();
const lastPage = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
---
<Base title="Blog" description="Writing by Dr. Mohit Vaishnav on applied AI, entrepreneurship, compliance and research.">
  <section class="container-page py-16 sm:py-20">
    <p class="eyebrow">Writing</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">Blog</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft dark:text-slate-400">
      Notes on applied AI, building Kimova, compliance, and lessons from research.
    </p>

    <div class="mt-12 space-y-6">
      {posts.length === 0 && <p class="text-ink-faint">No posts yet — check back soon.</p>}
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={1} lastPage={lastPage} />
  </section>
</Base>
