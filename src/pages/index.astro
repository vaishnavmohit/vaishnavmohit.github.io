---
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import PubCard from '@components/PubCard.astro';
import Icon from '@components/Icon.astro';
import { site, socials, stats } from '@data/site';
import { awards } from '@data/experience';
import pubData from '@data/publications.json';

const heroSocials = socials.filter((s) => s.primary);
const featuredAward = awards.find((a) => a.featured);
const featuredPubs = pubData.publications.filter((p) => p.featured).slice(0, 3);

const doors = [
  {
    href: '/founder', label: 'Founder', badge: 'bg-accent-50 text-accent-700 dark:bg-accent-500/10 dark:text-accent-300',
    title: 'Kimova AI', role: 'Co-founder & CEO · Tallinn, since 2024',
    body: 'An agentic AI co-auditor for ISO, SOC 2 and privacy audits, for audit firms and in-house compliance teams.',
    points: ['Selected for the Tehnopol AI Accelerator (2026)', 'Google Cloud Startup Program (2024)'],
    cta: 'The founder story',
  },
  {
    href: '/research', label: 'Researcher', badge: 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-300',
    title: 'Seeing vs. reasoning in AI', role: 'Postdoctoral Researcher · TalTech',
    body: 'Do vision-language models reason, or only pattern-match? I build diagnostics and benchmarks that tell the two apart.',
    points: ['TMLR 2026 · J2C at NeurIPS 2026', 'CoNLL 2026 · Oral presentation at ACL 2026'],
    cta: 'Research & publications',
  },
];
---
<Base pageType="ProfilePage">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 right-0 h-96 w-96 rounded-full bg-brand-500/10 blur-3xl"></div>
      <div class="absolute top-40 -left-20 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl"></div>
    </div>
    <div class="container-page grid items-center gap-12 py-16 sm:py-24 md:grid-cols-[1.5fr_1fr]">
      <div class="animate-fade-up">
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1 text-xs font-medium text-ink-soft dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300">
          <span class="h-2 w-2 rounded-full bg-signal-500"></span>
          <span>Co-founder &amp; CEO, <a href={site.company.url} class="font-semibold text-brand-600 dark:text-brand-300" target="_blank" rel="noopener">Kimova AI</a><span class="hidden sm:inline"> · Postdoctoral researcher, TalTech</span></span>
        </p>
        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl dark:text-white">
          Dr. Mohit Vaishnav
        </h1>
        <p class="mt-4 font-display text-2xl font-semibold leading-snug text-brand-600 sm:text-3xl dark:text-brand-400">
          AI researcher and founder.
        </p>
        <p class="mt-5 max-w-xl text-lg text-ink-soft dark:text-slate-400">
          I build <strong class="font-semibold text-ink dark:text-white">Kimova AI</strong>, an agentic AI co-auditor for
          ISO, SOC&nbsp;2 and privacy audits, and at TalTech I research how vision-language models perceive and reason.
          PhD from Brown University &amp; ANITI.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/founder" class="btn-primary">Founder — Kimova AI <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/research" class="btn-ghost">Research <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
        <div class="mt-8 flex items-center gap-3">
          {heroSocials.map((s) => (
            <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label}
              class="rounded-full border border-slate-200 p-2.5 text-ink-faint transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:text-slate-400 dark:hover:text-brand-300">
              <Icon name={s.id} class="h-5 w-5" />
            </a>
          ))}
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xs animate-fade-up md:max-w-none">
        <div class="absolute -inset-3 -z-10 rounded-3xl bg-gradient-to-tr from-brand-500/20 via-transparent to-accent-500/20 blur-xl"></div>
        <picture>
          <source type="image/webp" srcset="/img/profile-480.webp 480w, /img/profile-900.webp 900w" sizes="(min-width: 768px) 38vw, 320px" />
          <img src="/img/profile.jpg" alt="Dr. Mohit Vaishnav"
            width="480" height="600" loading="eager" fetchpriority="high" decoding="async"
            class="aspect-[4/5] w-full rounded-3xl border border-white/50 object-cover shadow-2xl dark:border-slate-800" />
        </picture>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-y border-slate-200 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-900/30">
    <div class="container-page grid grid-cols-2 gap-6 py-10 md:grid-cols-4">
      {stats.map((s) => {
        const ext = s.link?.startsWith('http');
        const Tag = s.link ? 'a' : 'div';
        return (
          <Tag
            href={s.link || undefined}
            target={ext ? '_blank' : undefined}
            rel={ext ? 'noopener' : undefined}
            class:list={['block', s.link && 'group transition-opacity hover:opacity-80']}
          >
            <p class="font-display text-2xl font-bold text-brand-600 lg:text-3xl dark:text-brand-400">{s.value}</p>
            <p class="mt-1 text-sm font-medium text-ink group-hover:underline dark:text-slate-200">{s.label}</p>
            <p class="text-xs text-ink-faint dark:text-slate-400">{s.detail}</p>
          </Tag>
        );
      })}
    </div>
  </section>

  <!-- FEATURED RECOGNITION -->
  {featuredAward && (
    <section class="container-page pt-10">
      <a href="/about#awards"
        class="group flex flex-col gap-4 rounded-2xl border border-accent-200 bg-gradient-to-r from-accent-50 via-white to-brand-50 p-5 transition-colors hover:border-accent-400 sm:flex-row sm:items-center sm:p-6 dark:border-accent-500/30 dark:from-accent-500/10 dark:via-transparent dark:to-brand-500/10">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-600 text-white">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">Recognition · {featuredAward.year}</span>
          <span class="mt-0.5 block font-display text-lg font-bold text-ink dark:text-white">{featuredAward.title}</span>
          <span class="block text-sm text-ink-soft dark:text-slate-400">{featuredAward.org}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-700 group-hover:underline dark:text-accent-300">All honors <Icon name="arrow" class="h-4 w-4" /></span>
      </a>
    </section>
  )}

  <!-- WHAT I'M BUILDING -->
  <Section eyebrow="What I do" title="Two tracks, one question" lead="Can we trust what an AI concludes? I work on it as a scientist and build on it as a founder.">
    <div class="grid gap-6 md:grid-cols-2">
      {doors.map((d) => (
        <a href={d.href} class="card card-hover group flex flex-col">
          <span class:list={['self-start rounded-full px-2.5 py-1 text-xs font-semibold', d.badge]}>{d.label}</span>
          <h3 class="mt-3 font-display text-2xl font-bold text-ink dark:text-white">{d.title}</h3>
          <p class="text-sm font-medium text-brand-600 dark:text-brand-300">{d.role}</p>
          <p class="mt-3 text-ink-soft dark:text-slate-400">{d.body}</p>
          <ul class="mt-4 space-y-1.5">
            {d.points.map((p) => (
              <li class="flex gap-2 text-sm text-ink-soft dark:text-slate-400"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>{p}</li>
            ))}
          </ul>
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:underline dark:text-brand-300">{d.cta} <Icon name="arrow" class="h-4 w-4" /></span>
        </a>
      ))}
    </div>
  </Section>

  <!-- FEATURED RESEARCH -->
  <Section eyebrow="Selected research" title="Frontier work in vision & reasoning" lead="Peer-reviewed at TMLR (J2C at NeurIPS 2026), CoNLL (oral at ACL 2026), ICLR and Neural Computation — research dimensions, work in progress and the full list on the research page.">
    <div class="grid gap-6 md:grid-cols-3">
      {featuredPubs.map((pub) => <PubCard pub={pub} />)}
    </div>
    <div class="mt-8">
      <a href="/research" class="btn-ghost">All publications <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <div class="relative overflow-hidden rounded-3xl border border-brand-200 bg-gradient-to-br from-brand-600 to-brand-800 px-8 py-14 text-center dark:border-brand-800">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Let's build the future of AI together</h2>
      <p class="mx-auto mt-4 max-w-2xl text-brand-100">
        Whether it's Kimova for your audits, a research collaboration, investment or speaking — I'd love to connect.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn bg-white text-brand-700 hover:bg-brand-50">Get in touch</a>
        <a href={site.company.url} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10">Explore Kimova AI</a>
      </div>
    </div>
  </Section>
</Base>
