---
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import Icon from '@components/Icon.astro';
import { site, socials, identityLinks } from '@data/site';
import { awards } from '@data/experience';

// Quick facts shown under the intro.
const facts = [
  { label: 'Now', value: 'Co-founder & CEO, Kimova AI · Postdoc, TalTech' },
  { label: 'Based in', value: 'Tallinn, Estonia' },
  { label: 'PhD', value: 'Brown University / ANITI · Université Toulouse III, 2023' },
  { label: 'Research niche', value: 'Active visual world models, working memory & agentic AI' },
  { label: 'Building', value: 'Framework-agnostic agentic AI workbench for auditors' },
  { label: 'Lived & worked', value: '10+ countries across Asia, Europe & the US' },
];

const snapshots = [
  {
    eyebrow: 'Early spark',
    title: 'Published & founded before grad school',
    body: 'Wrote my first IEEE Data Compression Conference papers as an undergraduate in Jaipur, then co-founded a computer-vision startup before heading to Europe.',
  },
  {
    eyebrow: 'Global perspective',
    title: 'Shaped across 10+ countries',
    body: 'Trained and worked across India, the UK, France, Spain, the US, Germany and Estonia — comfortable bridging cultures, disciplines and time zones.',
  },
  {
    eyebrow: 'Scientific curiosity',
    title: 'Brains, vision & active machines',
    body: 'Fascinated by how biological vision solves novel spatial puzzles in a few glances — and how to bring that active intelligence into AI and embodied systems.',
  },
  {
    eyebrow: 'Next stop · Jan 2027',
    title: 'Global Young Scientists Summit, Singapore',
    body: 'Selected among early-career scientists worldwide for a week of dialogue with Nobel, Fields Medal and Turing Award laureates.',
  },
];

const principles = [
  {
    title: 'Evidence over shortcuts',
    body: 'Whether testing a scientific hypothesis or shipping enterprise software, strong conclusions require traceable, reproducible evidence rather than surface heuristics.',
  },
  {
    title: 'Distinct, focused hats',
    body: 'Open academic science on visual & embodied intelligence at TalTech and enterprise audit software at Kimova AI run as independent tracks — each held to its own standard of rigor.',
  },
  {
    title: 'Open doors & mentorship',
    body: 'Great opportunities shaped my own path from Jaipur to Providence and Tallinn — I stay actively open to mentoring students, trading ideas and collaborating across borders.',
  },
];

const featured = awards.find((a) => a.featured);
const startYear = (y: string) => Number(y.match(/\d{4}/)?.[0] ?? 0);
const otherAwards = awards.filter((a) => a !== featured).sort((a, b) => startYear(b.year) - startYear(a.year));

const social = socials.filter((s) => s.id !== 'email');
const description =
  'About Dr. Mohit Vaishnav — Co-founder & CEO of Kimova AI in Tallinn, postdoctoral researcher at TalTech, PhD in cognitive AI and visual reasoning (Toulouse III, Brown, ANITI). GYSS 2027 participant.';
---
<Base title="About" description={description} pageType="ProfilePage" image={site.ogImage}>
  <section class="container-page py-16 sm:py-20">
    <div class="grid items-start gap-10 md:grid-cols-[1fr_1.6fr] md:gap-12">
      <div class="mx-auto w-full max-w-[16rem] md:sticky md:top-24 md:max-w-none">
        <picture>
          <source type="image/webp" srcset="/img/about-420.webp 420w, /img/about-675.webp 675w" sizes="(min-width: 768px) 30vw, 256px" />
          <img src="/img/about.jpg" alt="Dr. Mohit Vaishnav" width="420" height="525" fetchpriority="high" decoding="async"
            class="aspect-[4/5] w-full rounded-3xl border border-slate-200 object-cover object-top shadow-xl dark:border-slate-800" />
        </picture>
        <div class="mt-5 flex justify-center gap-3 md:justify-start">
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label}
              class="rounded-full border border-slate-200 p-2.5 text-ink-faint transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:text-slate-400 dark:hover:text-brand-300">
              <Icon name={s.id} class="h-4 w-4" />
            </a>
          ))}
        </div>
      </div>

      <div>
        <p class="eyebrow">About me</p>
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">
          Scientist by training, builder at heart
        </h1>
        <div class="prose-portfolio mt-6 space-y-4 text-lg text-ink-soft dark:text-slate-400">
          <p>
            Hi — I’m <strong class="text-ink dark:text-white">Dr. Mohit Vaishnav</strong>. Based in Tallinn, Estonia, I
            wear two distinct hats that keep me energized every day: building an enterprise software company as a
            founder, and exploring the frontiers of visual and embodied intelligence as an academic scientist.
          </p>
          <p>
            As Co-founder and CEO of <a href={site.company.url} target="_blank" rel="noopener">Kimova AI</a>
            (selected for the <a href="https://www.tehnopol.ee/en/accelerator/the-ai-accelerator/" target="_blank" rel="noopener">Tehnopol AI Accelerator</a>),
            we are building a <strong class="text-ink dark:text-white">framework-agnostic, agentic workbench for auditors</strong> —
            giving audit firms and assurance teams one intelligent workspace to run any regulatory, security, quality or
            custom audit end-to-end.
          </p>
          <p>
            In academia, I am a postdoctoral researcher in the
            <a href="https://taltech.ee/en/contacts/applied-artificial-intelligence-group/mohit-vaishnav" target="_blank" rel="noopener">Applied Artificial Intelligence Group at TalTech</a>
            under the <a href="https://exai.ee" target="_blank" rel="noopener">Estonian Centre of Excellence in AI (EXAI)</a>.
            My work focuses on perceptually native visual world models, active attention-and-memory loops, and
            verifiable multimodal workflows — with recent papers in
            <a href="https://arxiv.org/abs/2507.07574" target="_blank" rel="noopener">TMLR (J2C at NeurIPS 2026)</a>
            and <a href="https://arxiv.org/abs/2604.21346" target="_blank" rel="noopener">CoNLL / ACL 2026 (Oral)</a>,
            supported by <a href="https://antigravity.google/use-cases/science" target="_blank" rel="noopener">Google Antigravity for Science</a>.
          </p>
          <p>
            Before Tallinn, my curiosity took me across three continents. I completed my PhD in cognitive AI and
            computer vision between <a href="https://serre.lab.brown.edu" target="_blank" rel="noopener">Brown University’s Serre Lab</a>
            and <a href="https://aniti.univ-toulouse.fr" target="_blank" rel="noopener">ANITI</a>
            (<a href="https://www.univ-tlse3.fr" target="_blank" rel="noopener">Université Toulouse III</a>,
            <a href="https://theses.fr/2023TOU30139" target="_blank" rel="noopener">official record</a>) with
            Prof.&nbsp;Thomas Serre and Prof.&nbsp;Nicholas Asher, publishing at
            <a href="https://arxiv.org/abs/2206.05379" target="_blank" rel="noopener">NeurIPS</a>,
            <a href="https://openreview.net/forum?id=iLMgk2IGNyv" target="_blank" rel="noopener">ICLR</a> and
            <a href="https://doi.org/10.1162/neco_a_01485" target="_blank" rel="noopener">Neural Computation</a>.
            Earlier came an Erasmus Mundus master’s in Vision &amp; Robotics across
            <a href="https://www.hw.ac.uk" target="_blank" rel="noopener">Heriot-Watt</a> (UK),
            <a href="https://www.u-bourgogne.fr" target="_blank" rel="noopener">Université de Bourgogne</a> (France) and
            <a href="https://www.udg.edu" target="_blank" rel="noopener">Universitat de Girona</a> (Spain), applied AI
            roles at <a href="https://www.home.sandvik" target="_blank" rel="noopener">Sandvik</a> and
            <a href="https://www.dfki.de/en/web" target="_blank" rel="noopener">DFKI</a> in Germany, and an engineering
            degree at <a href="https://www.lnmiit.ac.in" target="_blank" rel="noopener">LNMIIT</a> in India — where I
            published my first <a href="https://ieeexplore.ieee.org/document/5749537" target="_blank" rel="noopener">IEEE DCC</a>
            papers as an undergrad.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Say hello / connect</a>
          <a href={site.cvUrl} target="_blank" rel="noopener" class="btn-ghost">Download CV <Icon name="external" class="h-4 w-4" /></a>
          <a href="/research" class="btn-ghost">Research vision <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/experience" class="btn-ghost">Full timeline <Icon name="arrow" class="h-4 w-4" /></a>
        </div>

        <!-- At a glance -->
        <dl class="mt-10 grid gap-x-8 gap-y-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800">
          {facts.map((f) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-ink-faint">{f.label}</dt>
              <dd class="mt-1 text-sm font-medium text-ink dark:text-slate-200">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Beyond the CV: Personal snapshots -->
  <Section eyebrow="Beyond the CV" title="Four things to know about me" class="border-t border-slate-200 bg-slate-50/50 dark:border-slate-800 dark:bg-slate-900/20">
    <ul role="list" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {snapshots.map((s) => (
        <li class="card flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-accent-600 dark:text-accent-400">{s.eyebrow}</span>
            <h3 class="mt-1.5 font-display text-base font-bold text-ink dark:text-white">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-slate-400">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Recognition -->
  <Section eyebrow="Recognition" title="Awards & honors" id="awards" class="border-t border-slate-200 dark:border-slate-800">
    {featured && (
      <a href={featured.href} target="_blank" rel="noopener"
        class="group mb-6 flex flex-col gap-5 rounded-2xl border border-accent-200 bg-gradient-to-br from-accent-50 via-white to-brand-50 p-6 transition-colors hover:border-accent-400 sm:flex-row sm:p-8 dark:border-accent-500/30 dark:from-accent-500/10 dark:via-transparent dark:to-brand-500/10">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent-600 text-white">
          <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1"/></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">{featured.year} · {featured.tags[0]}</span>
          <span class="mt-1 block font-display text-xl font-bold text-ink sm:text-2xl dark:text-white">{featured.title}</span>
          <span class="mt-1 block text-sm font-medium text-brand-600 dark:text-brand-300">{featured.org}</span>
          <span class="mt-3 block max-w-3xl text-ink-soft dark:text-slate-400">{featured.description}</span>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-700 group-hover:underline dark:text-accent-300">About GYSS <Icon name="external" class="h-3.5 w-3.5" /></span>
        </span>
      </a>
    )}
    <div class="grid gap-5 md:grid-cols-2">
      {otherAwards.map((a) => (
        <div class="card flex gap-4">
          <div class="w-20 shrink-0 font-display text-sm font-bold text-accent-600 dark:text-accent-400">{a.year}</div>
          <div>
            <h3 class="font-semibold text-ink dark:text-white">
              {a.href ? <a href={a.href} target="_blank" rel="noopener" class="hover:text-brand-600 hover:underline dark:hover:text-brand-300">{a.title}</a> : a.title}
            </h3>
            <p class="text-sm font-medium text-brand-600 dark:text-brand-300">{a.org}</p>
            <p class="mt-1.5 text-sm text-ink-soft dark:text-slate-400">{a.description}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Principles -->
  <Section eyebrow="How I work" title="Operating principles" class="border-t border-slate-200 dark:border-slate-800">
    <div class="grid gap-6 md:grid-cols-3">
      {principles.map((p) => (
        <div class="card">
          <h3 class="font-display text-lg font-bold text-ink dark:text-white">{p.title}</h3>
          <p class="mt-2 text-sm text-ink-soft dark:text-slate-400">{p.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Identity: canonical bio + profiles -->
  <Section class="border-t border-slate-200 dark:border-slate-800">
    <div class="grid gap-8 md:grid-cols-[1.6fr_1fr]">
      <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-6 dark:border-slate-800 dark:bg-slate-900/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Short bio · free to reuse</p>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-slate-400">{site.bio}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Verified profiles elsewhere</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {identityLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="me noopener" class="inline-flex items-center gap-1 font-medium link-underline">
                {l.label} <Icon name="external" class="h-3 w-3" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>
</Base>
