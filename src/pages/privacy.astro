---
import Base from '@layouts/Base.astro';
import { site } from '@data/site';
const updated = 'June 2026';
---
<Base title="Privacy" description="Privacy notice for vaishnavmohit.github.io — what data is collected and how it's used.">
  <section class="container-page max-w-3xl py-16 sm:py-20">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">Privacy notice</h1>
    <p class="mt-3 text-sm text-ink-faint">Last updated: {updated}</p>

    <div class="prose-portfolio mt-8">
      <p>This is the personal website of {site.fullName}. It's intentionally lightweight and collects as little data as possible.</p>

      <h2>Analytics &amp; cookies</h2>
      <p>
        This site uses <strong>Google Analytics 4</strong> to understand aggregate, anonymous traffic
        (which pages are visited, roughly where visitors come from), with IP addresses anonymized. It runs
        with <strong>Google Consent Mode</strong>: by default analytics operate in a <strong>cookieless</strong>
        mode (no analytics cookies are stored). Only if you click <strong>“Accept”</strong> on the cookie
        banner are analytics cookies enabled; if you decline, it stays cookieless.
      </p>
      <p>
        You can change your choice at any time by clearing this site's data in your browser, which will make
        the cookie banner appear again.
      </p>

      <h2>Contact form</h2>
      <p>
        The contact form is handled by <a href="https://web3forms.com" target="_blank" rel="noopener">Web3Forms</a>.
        When you submit it, the name, email and message you enter are delivered to my inbox so I can reply.
        That information is used only to respond to you and is not sold or shared.
      </p>

      <h2>External links</h2>
      <p>
        This site links to third-party platforms (LinkedIn, GitHub, Google Scholar, arXiv, Kimova AI and
        others). Their own privacy policies apply once you leave this site.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on <strong>GitHub Pages</strong>. Like most web hosts, GitHub may process basic
        request logs (such as IP addresses) for security and operational purposes.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this notice? Reach me via the <a href="/contact">contact page</a>.
      </p>
    </div>
  </section>
</Base>
