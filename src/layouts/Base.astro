---
import '@fontsource-variable/inter';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '../styles/global.css';
import SEO from '@components/SEO.astro';
import Analytics from '@components/Analytics.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CookieConsent from '@components/CookieConsent.astro';
import type { PageType } from '../lib/schema';
// Preload the two Latin font files every page paints with (hashes match the CSS references)
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import soraWoff2 from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  /** schema.org page type — ProfilePage for pages that are about you */
  pageType?: PageType;
  /** Extra JSON-LD nodes for this page */
  schema?: Record<string, unknown>[];
  /** @deprecated use pageType="ProfilePage" */
  isHome?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/img/icon-180.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={soraWoff2} crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog · Dr. Mohit Vaishnav" href="/rss.xml" />
    <meta name="theme-color" content="#2f6fef" />
    <meta name="generator" content={Astro.generator} />
    <!-- Set theme before paint to avoid flash -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        const m = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (t === 'dark' || (!t && m)) document.documentElement.classList.add('dark');
      })();
    </script>
    <SEO {...props} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
